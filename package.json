{
  "name": "wikihow",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@orama/stemmers": "^3.1.18",
    "@orama/stopwords": "^3.1.18",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "minisearch": "^7.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:dev-build": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "build:apk": "npx eas-cli@latest build --platform android --profile preview",
    "conteudo:validar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validar-conteudo.mts",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"testes/*.test.mts\"",
    "test:cobertura": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-test-coverage --test \"testes/*.test.mts\"",
    "build:release": "npx eas-cli@latest build --platform android --profile production"
  },
  "private": true
}
